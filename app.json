{
  "expo": {
    "name": "LFA Ticketing",
    "slug": "lfa-app",
    "owner": "jasquare",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/lfa-app-icon.png",
    "scheme": "lfa-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/lfa-app-icon-ios.png"
    },
    "android": {
      "icon": "./assets/images/lfa-app-icon-android.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.lfaticketing.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F8",
          "image": "./assets/images/lfa-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F172A",
            "image": "./assets/images/lfa-logo.png"
          }
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c00bc35-1365-441d-b030-94e4e3bb286a"
      }
    }
  }
}
