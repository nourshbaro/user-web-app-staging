{
  "expo": {
    "name": "LFA Tickets",
    "slug": "lfa-app",
    "owner": "jasquare",
    "version": "2.0.1",
    "orientation": "default",
    "icon": "./assets/images/app-icon-ios.png",
    "scheme": "lfa-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon-ios.png",
      "bundleIdentifier": "com.lfaticketing.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "icon": "./assets/images/app-icon-android.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-android-foreground.png",
        "backgroundColor": "#E9E9EE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lfaticketing.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F6",
          "image": "./assets/images/lfa-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0B0E",
            "image": "./assets/images/lfa-logo.png"
          }
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/messaging",
      "./plugins/withFirebaseModularHeaders.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LFA Tickets to access your photos so you can choose a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c00bc35-1365-441d-b030-94e4e3bb286a"
      }
    }
  }
}
